# Tracker Mode: 'real' (live Keitaro tracker) or 'demo' (autonomous simulator)
KT_MODE=real
DEMO_SIMULATOR_URL=http://127.0.0.1:8001

# Keitaro Admin API Configuration (used when KT_MODE=real)
# Base URL should be tracker root without /admin or /admin_api/v1
KEITARO_BASE_URL=https://tracker.example
KEITARO_API_KEY=
# Surname used for campaign prefix: test_<surname>_...
CAMPAIGN_SURNAME=novikov

# Optional default IDs for domain, group, and traffic source in Campaign Creator
# DEFAULT_DOMAIN_ID=
# DEFAULT_GROUP_ID=
# DEFAULT_TRAFFIC_SOURCE_ID=

# Application & Database Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
APP_SECRET_KEY=generate-random-secret-key-for-session-or-auth

# Commit SHA / Version injected in build/runtime
APP_VERSION=0.1.0
COMMIT_SHA=dev
