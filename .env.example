# Keitaro connection
KT_MODE=real

# Keitaro Admin API Configuration (used when KT_MODE=real)
# Base URL should be tracker root without /admin or /admin_api/v1
KEITARO_BASE_URL=https://tracker.example
# Optional legacy service key; web login validates each visitor's own key in Keitaro.
KEITARO_API_KEY=

# Optional default IDs for domain, group, and traffic source in Campaign Creator
# DEFAULT_DOMAIN_ID=
# DEFAULT_GROUP_ID=
# DEFAULT_TRAFFIC_SOURCE_ID=

# Application & Database Configuration
# Local launch: APP_ENV=development uses plain HTTP on 127.0.0.1:8000
# Public launch: APP_ENV=production enforces HTTPS for real mode login
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
REAL_DATABASE_URL=sqlite:///./data/app.db
SECURITY_DATABASE_URL=sqlite:///./data/security.db
APP_SECRET_KEY=dev-secret-key-change-in-prod

# Commit SHA / Version injected in build/runtime
APP_VERSION=0.1.0
COMMIT_SHA=dev
